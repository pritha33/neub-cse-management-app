rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && userDoc().exists() ? userDoc().data.role : null;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || role() == "admin");
      allow update: if signedIn() && (request.auth.uid == userId || role() == "admin");
      allow delete: if signedIn() && role() == "admin";
    }

    match /notices/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && role() == "admin";
    }

    match /routines/{id} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && role() == "admin";
    }

    match /materials/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && role() == "teacher";
      allow update, delete: if signedIn() && (role() == "admin" || resource.data.teacherUid == request.auth.uid);
    }

    match /assignments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && role() == "teacher";
      allow update, delete: if signedIn() && (role() == "admin" || resource.data.teacherUid == request.auth.uid);
    }

    match /submissions/{id} {
      allow create: if signedIn() && role() == "student";
      allow read: if signedIn() && (role() == "admin" || resource.data.studentUid == request.auth.uid || role() == "teacher");
      allow update, delete: if signedIn() && role() == "admin";
    }

    match /payments/{id} {
      allow read: if signedIn() && (role() == "admin" || resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if signedIn() && role() == "admin";
    }

    match /classUpdates/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && role() == "teacher";
      allow update, delete: if signedIn() && (role() == "admin" || resource.data.teacherUid == request.auth.uid);
    }

    match /activities/{id} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update, delete: if signedIn() && role() == "admin";
    }
  }
}
